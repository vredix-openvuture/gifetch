// Compact example config for gifetch: one block, no sections. Try it with
//   gifetch -c examples/compact.jsonc
// Same rules as the default: plain keys padded by hand, no display.key.width, no Nerd Font icons.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "separator": "  ",
        "color": { "keys": "#9fb59a", "output": "#ffffff", "separator": "#5c5250" },
        "percent": { "type": ["num", "bar"], "color": { "green": "#9fb59a", "yellow": "#d8b46a", "red": "#d97a6c" } },
        "bar": { "width": 10, "char": { "elapsed": "■", "total": "·" }, "border": { "left": "", "right": "" } }
    },
    "modules": [
        { "type": "title", "format": "{##9fb59a}{user-name}{##5c5250} on {##ffffff}{host-name}" },
        "break",
        { "type": "os",       "key": "os      " },
        { "type": "kernel",   "key": "kernel  " },
        { "type": "uptime",   "key": "up      " },
        { "type": "wm",       "key": "wm      " },
        { "type": "shell",    "key": "shell   " },
        { "type": "memory",   "key": "memory  ", "format": "{used} / {total}  {percentage-bar}" },
        "break",
        { "type": "colors", "symbol": "circle" }
    ]
}
