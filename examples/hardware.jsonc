// Hardware example config for gifetch: the machine with load bars, in cool blues. Try it with
//   gifetch -c examples/hardware.jsonc
// Same rules as the default: plain keys padded by hand, no display.key.width, no Nerd Font icons.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "separator": " │ ",
        "color": { "keys": "#7fb8d8", "output": "#e6eef2", "separator": "#3d5566" },
        "percent": { "type": ["bar", "num"], "color": { "green": "#7fd8c4", "yellow": "#d8c47f", "red": "#d87f8f" } },
        "bar": { "width": 14, "char": { "elapsed": "━", "total": "─" }, "border": { "left": "", "right": "" } }
    },
    "modules": [
        { "type": "title", "format": "{##7fb8d8}┌─ {##e6eef2}{host-name}" },
        { "type": "host",     "key": "│ board  " },
        { "type": "cpu",      "key": "│ cpu    ", "format": "{name} ({cores-logical})" },
        { "type": "gpu",      "key": "│ gpu    ", "format": "{name}" },
        { "type": "cpuusage", "key": "│ load   ", "format": "{avg-bar} {avg}" },
        { "type": "memory",   "key": "│ memory ", "format": "{percentage-bar} {used} / {total}" },
        { "type": "swap",     "key": "│ swap   ", "format": "{percentage-bar} {used} / {total}" },
        { "type": "disk",     "key": "│ disk   ", "folders": "/", "format": "{size-percentage-bar} {size-used} / {size-total}" },
        { "type": "uptime",   "key": "│ uptime " },
        { "type": "custom", "format": "{##7fb8d8}└──────────────" },
        "break",
        { "type": "colors", "symbol": "diamond" }
    ]
}
