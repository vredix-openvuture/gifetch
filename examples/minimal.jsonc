// Minimal example config for gifetch: five lines, warm colours. Try it with
//   gifetch -c examples/minimal.jsonc
// Same rules as the default: plain keys padded by hand, no display.key.width, no Nerd Font icons.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "separator": "  ",
        "color": { "keys": "#e8a87c", "output": "#f4e9e1", "separator": "#8a6f5f" }
    },
    "modules": [
        { "type": "title", "format": "{##f4e9e1}hi, {##e8a87c}{user-name}" },
        "break",
        { "type": "os",     "key": "os    ", "format": "{pretty-name}" },
        { "type": "wm",     "key": "wm    " },
        { "type": "shell",  "key": "sh    " },
        { "type": "uptime", "key": "up    " },
        "break",
        { "type": "colors", "symbol": "square" }
    ]
}
